# Copy to .env and replace every value. Never commit the real .env file.

# Database account used by the application
MRMS_DB_USERNAME=mrms_app
MRMS_DB_PASSWORD=change-me-to-a-long-random-password

# 32 byte key, base64 encoded, for AES-256-GCM encryption of uploaded files.
# Generate with:  openssl rand -base64 32
# Losing this key makes stored documents unreadable: keep a secure backup.
MRMS_STORAGE_KEY=

# First administrator, created only when no administrator exists.
# The password must be changed at first sign in.
MRMS_ADMIN_USERNAME=ADMIN
MRMS_ADMIN_PASSWORD=

# Standard file name patterns (optional). Tokens: {owner} {claim} {category} {date} {seq}
# MRMS_DOC_UPLOAD_PATTERN={owner}_{category}_{date}_{seq}
# MRMS_DOC_CLAIM_PATTERN={claim}_{category}_{seq}

# Address users reach the portal at (used as the eSign return address)
MRMS_PUBLIC_BASE_URL=https://mrms.example.gov.in

# Signing of certificates, countersignatures, sanctions and payments:
# password (default) or esign. Aadhaar eSign needs the Directorate's
# registration as an Application Service Provider with a licensed ESP.
MRMS_SIGNING_MODE=password
# MRMS_ESP_NAME=
# MRMS_ESP_ASP_ID=
# MRMS_ESP_URL=
# MRMS_ESP_ORIGIN=
# MRMS_ESP_ASP_KEYSTORE=/run/secrets/asp.p12
# MRMS_ESP_ASP_KEYSTORE_PASSWORD=
# MRMS_ESP_CERTIFICATES=/run/secrets/esp.pem
# MRMS_ESP_TRUSTED_CAS=/run/secrets/cca-and-esp-ca.pem

# E-mail and SMS notifications: off, log, or smtp / http
MRMS_MAIL_MODE=off
# MRMS_MAIL_FROM=mrms-noreply@example.gov.in
# SPRING_MAIL_HOST=
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
MRMS_SMS_MODE=off
# MRMS_SMS_URL_TEMPLATE=https://sms-gateway.example.gov.in/send?mobile={mobile}&message={message}&template={templateId}
# MRMS_SMS_TEMPLATE_ID=

# Host port for the web container (loopback only)
MRMS_WEB_PORT=8080
